# Copiez ce fichier en ".env" pour tester en local (ne JAMAIS committer le vrai .env sur GitHub)
# Sur Render, ces mêmes variables se configurent dans Dashboard > votre service > Environment

# Clé secrète Flask : générez-en une avec la commande indiquée dans le guide de déploiement
SECRET_KEY=change-moi-avec-une-vraie-cle-secrete

# --- Gmail SMTP ---
# MAIL_USERNAME = votre adresse Gmail complète
# MAIL_PASSWORD = le "mot de passe d'application" à 16 caractères (PAS votre mot de passe Gmail normal)
MAIL_USERNAME=votreadresse@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx

# --- Cloudflare Turnstile (anti-robot) ---
TURNSTILE_SITE_KEY=votre-cle-publique
TURNSTILE_SECRET_KEY=votre-cle-secrete
